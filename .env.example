# Copy to .env and adjust. All optional — sane defaults are built in.
PORT=8787
# Absolute path is safest in production (systemd WorkingDirectory may differ):
KINGSEN_DB=/opt/kingsen/kingsen.db
# Comma-separated allowed origins. Use your real domain(s) in production.
# "*" allows any origin (fine to start, lock down later).
KINGSEN_ORIGINS=https://kingsen.app,https://www.kingsen.app
